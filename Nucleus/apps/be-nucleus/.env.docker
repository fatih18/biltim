# ---------------------------------------------------------------------------
# Biltim backend — container environment.
#
# EVERY BLANK BELOW IS REQUIRED. Leaving one empty does not start a degraded
# service: nucleus validates config at boot and refuses to listen, naming the
# variable. That is deliberate and it is why the placeholders are empty rather
# than filled with something that looks plausible.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=1001

# --- database ------------------------------------------------------------
# The CUSTOMER'S Postgres. Their schema is not replaced; nucleus adds what is
# missing and leaves the 332 existing columns alone.
# Using the bundled docker-compose.db.yml instead? Then host is `postgres`.
DATABASE_URL=

# --- redis ---------------------------------------------------------------
# host+port, not a URL. Using docker-compose.db.yml? Then REDIS_HOST=redis.
REDIS_HOST=
REDIS_PORT=6379

# --- token secrets -------------------------------------------------------
# Three DIFFERENT values, generated on the server, 32+ characters each:
#     openssl rand -base64 48
#
# These are not decoration. Change one after go-live and every open session on
# that token dies. Keep them somewhere you can find them again — a rebuilt
# container with new secrets logs everybody out.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_TOKEN_SECRET=

# --- superuser -----------------------------------------------------------
# Only used to CREATE the account when it does not exist yet. On the customer's
# existing database the godmin row is already there, and this password will NOT
# overwrite it — measured. If you need that account's password changed on an
# existing database, change it in the database.
GODMIN_EMAIL=
GODMIN_PASSWORD=

# --- plan mails ----------------------------------------------------------
# OPTIONAL: the blanks of this block (APP_BASE_URL and SMTP_*) may stay empty;
# the warning at the top is about the others. With every SMTP_* empty no mail
# leaves the app and nothing else changes: the boot prints no error.
# There is NO admin panel that switches mail on. Mail needs TWO things on the
# server, and a change to either needs a restart of the backend:
#   1. the SMTP_* values below: it comes on at boot when SMTP_HOST, SMTP_USER
#      and SMTP_PASSWORD are all filled in; with only some of them set, the boot
#      log names the missing ones and mail stays off;
#   2. the `nodemailer` npm package, installed by hand ONCE while the server has
#      npm access (in the be-nucleus folder: bun add nodemailer). It is not in
#      package.json on purpose: a changed package file makes update.sh run
#      `bun install --frozen-lockfile`, which stops the whole update where npm
#      is closed. Without it the boot log says "is `nodemailer` installed in
#      this app?" and the status line on Ana Veri Yonetimi says the package is
#      missing. Note: bun add changes package.json and bun.lock, and update.sh
#      refuses to run on changed files; undo them with
#      git checkout -- Nucleus/apps/be-nucleus/package.json Nucleus/bun.lock
#      before the next update.
#
# The address people open the app at, used for the link in the plan mails
# (invitation, audit result). Empty: the mails go out without a link.
# Origin plus an optional path, http or https, for example:
#     APP_BASE_URL=http://172.26.16.27:3000
APP_BASE_URL=
#
# The mail server, for Microsoft 365 or any other SMTP server:
#     SMTP_HOST          smtp.office365.com
#     SMTP_PORT          empty = 587 (STARTTLS); 465 for implicit TLS
#     SMTP_SECURE        empty = by port; true = implicit TLS, false = STARTTLS
#     SMTP_USER          the mailbox that sends
#     SMTP_PASSWORD      the mailbox's app password (spaces Microsoft prints in it are ignored)
#     SMTP_SENDER_ADDRESS  the From address; empty = the mailbox itself
#     SMTP_FROM_NAME     the sender name people see; empty = Biltim 5S
# Exchange Online: SMTP AUTH is off per tenant by default and refuses a correct
# password until the mailbox has it enabled (ask the Microsoft 365 admin).
# The status line on Ana Veri Yonetimi shows whether mail is on and what is waiting.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=
SMTP_FROM_NAME=
