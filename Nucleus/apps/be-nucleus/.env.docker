# ---------------------------------------------------------------------------
# Biltim backend — container environment.
#
# EVERY BLANK BELOW IS REQUIRED. Leaving one empty does not start a degraded
# service: nucleus validates config at boot and refuses to listen, naming the
# variable. That is deliberate and it is why the placeholders are empty rather
# than filled with something that looks plausible.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=1001

# --- database ------------------------------------------------------------
# The CUSTOMER'S Postgres. Their schema is not replaced; nucleus adds what is
# missing and leaves the 332 existing columns alone.
# Using the bundled docker-compose.db.yml instead? Then host is `postgres`.
DATABASE_URL=

# --- redis ---------------------------------------------------------------
# host+port, not a URL. Using docker-compose.db.yml? Then REDIS_HOST=redis.
REDIS_HOST=
REDIS_PORT=6379

# --- token secrets -------------------------------------------------------
# Three DIFFERENT values, generated on the server, 32+ characters each:
#     openssl rand -base64 48
#
# These are not decoration. Change one after go-live and every open session on
# that token dies. Keep them somewhere you can find them again — a rebuilt
# container with new secrets logs everybody out.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_TOKEN_SECRET=

# --- superuser -----------------------------------------------------------
# Only used to CREATE the account when it does not exist yet. On the customer's
# existing database the godmin row is already there, and this password will NOT
# overwrite it — measured. If you need that account's password changed on an
# existing database, change it in the database.
GODMIN_EMAIL=
GODMIN_PASSWORD=

# --- plan mails ----------------------------------------------------------
# OPTIONAL: the blanks of this block (APP_BASE_URL and AZURE_EMAIL_*) may stay
# empty; the warning at the top is about the others. With the connection string
# or the sender address empty no mail leaves the app and nothing else changes:
# the boot prints no error. SMTP and Gmail are not used.
# There is NO admin panel that switches mail on. Mail is sent through nucleus's
# own Azure Communication Services provider and needs, on the server:
#   1. AZURE_EMAIL_CONNECTION_STRING and AZURE_EMAIL_SENDER_ADDRESS below: mail
#      comes on at boot when BOTH are filled in; with only one set, the boot log
#      names the missing one and mail stays off. A change needs a restart of the
#      backend;
#   2. the `@azure/communication-email` npm package. It is already in bun.lock
#      (an optional dependency of nucleus-core-ts), so the `bun install` that
#      installed nucleus-core-ts on the server installed it too: nothing is added
#      by hand and package.json does not change. If it is missing, the status
#      line on Ana Veri Yonetimi says the package is not installed.
#
# The address people open the app at, used for the link in the plan mails
# (invitation, audit result). Empty: the mails go out without a link.
# Origin plus an optional path, http or https, for example:
#     APP_BASE_URL=http://172.26.16.27:3000
APP_BASE_URL=
#
# The Azure Communication Services Email resource the mails go through:
#     AZURE_EMAIL_CONNECTION_STRING  the connection string of the Communication
#                                    Services resource that has an Email domain
#                                    connected (Azure portal: the resource, Keys)
#     AZURE_EMAIL_SENDER_ADDRESS     a sender address of a verified domain of
#                                    that resource (its MailFrom address, e.g.
#                                    DoNotReply@<domain>)
#     AZURE_EMAIL_FROM_NAME          optional sender name; empty = Biltim 5S
#                                    (nucleus 0.10.115 keeps the name but Azure
#                                    shows the sender address on the message)
# The status line on Ana Veri Yonetimi shows whether mail is on and what is waiting.
AZURE_EMAIL_CONNECTION_STRING=
AZURE_EMAIL_SENDER_ADDRESS=
AZURE_EMAIL_FROM_NAME=
