{
  "appId": "biltim",
  "rateLimit": {
    "privateRoutes": { "window": "1m", "max": 3000 },
    "publicRoutes": { "window": "1m", "max": 3000 },
    "authRoutes": {
      "window": "1m",
      "max": 300,
      "login": { "window": "15m", "max": 300, "blockDuration": "1m" },
      "register": { "window": "1h", "max": 100, "blockDuration": "1m" },
      "passwordReset": { "window": "1h", "max": 100, "blockDuration": "1m" },
      "magicLink": { "window": "1h", "max": 100, "blockDuration": "1m" }
    }
  },
  "mode": "development",
  "database": {
    "url": "DATABASE_URL",
    "isMultiTenant": false,
    "sharedSchema": "main",
    "allowDataLoss": false
  },
  "redis": {
    "host": "REDIS_HOST",
    "port": "REDIS_PORT"
  },
  "logging": {
    "level": "info",
    "requests": {
      "excludePaths": [
        "/health"
      ]
    }
  },
  "security": {
    "maxRequestBodyBytes": 52428800
  },
  "authentication": {
    "enabled": true,
    "mode": "full",
    "defaultRole": "basic",
    "accessToken": {
      "secret": "ACCESS_TOKEN_SECRET",
      "expiresIn": "30m",
      "name": "nucleus_access_token"
    },
    "refreshToken": {
      "secret": "REFRESH_TOKEN_SECRET",
      "expiresIn": "30d",
      "name": "nucleus_refresh_token"
    },
    "sessionToken": {
      "secret": "SESSION_TOKEN_SECRET",
      "name": "nucleus_session_token"
    },
    "login": {
      "enabled": true,
      "isPublic": true,
      "rememberMe": true
    },
    "register": {
      "enabled": true,
      "isPublic": true,
      "createProfileOnRegister": true
    },
    "logout": {
      "enabled": true,
      "isPublic": true
    },
    "refresh": {
      "enabled": true,
      "isPublic": true
    },
    "me": {
      "enabled": true,
      "includeProfile": true,
      "includeRoles": true,
      "includeAddresses": true,
      "includePhones": true,
      "includeFiles": true
    }
  },
  "authorization": {
    "enabled": true,
    "autoSeedClaims": true,
    "godminEmail": "GODMIN_EMAIL",
    "godminPassword": "GODMIN_PASSWORD",
    "jwtClaimsMode": "resolve"
  },
  "audit": {
    "enabled": true
  },
  "storage": {
    "enabled": true,
    "basePath": "./storage",
    "maxFileSizeBytes": 52428800,
    "cdn": {
      "enabled": true,
      "cacheMaxAge": 86400
    }
  },
  "notification": {
    "enabled": true,
    "channels": {
      "portal": true
    }
  },
  "verification": {
    "enabled": true
  },
