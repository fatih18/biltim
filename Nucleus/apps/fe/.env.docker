# ---------------------------------------------------------------------------
# Biltim frontend — container environment.
#
# All of it is read at RUNTIME, so changing any of it is a restart, not a
# rebuild. Nothing here is baked into the image.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- backend address -----------------------------------------------------
# Server-side only; the browser never sees it. Inside compose the backend is
# reachable by service name, so this is normally left exactly as it is.
AUTH_API_URL=http://be:1001

# --- server actions ------------------------------------------------------
# Next encrypts server-action payloads with this. If it is unset, Next generates
# one per build — and then two containers, or one container after a restart,
# cannot read each other's actions and the screens fail with an opaque error.
# Generate ONCE and keep it:
#     openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- identity bypass -----------------------------------------------------
# A development escape hatch that sends a header telling the backend to skip
# identity checks. It must be false in production. Never set this to true on a
# customer server.
BYPASS_IDENTITY_MIDDLEWARE=false
